{
  "name": "@emporium/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.js",
    "./schema": "./src/schema/index.js"
  },
  "scripts": {
    "build": "node -e \"import('./src/index.js')\"",
    "lint": "eslint src scripts test drizzle.config.js",
    "test": "node --test",
    "db:generate": "drizzle-kit generate --config drizzle.config.js",
    "db:migrate": "node scripts/migrate.js",
    "db:roles": "node scripts/configure-roles.js",
    "db:check": "node scripts/check-database.js",
    "db:branch:create": "node scripts/create-preview-branch.js"
  },
  "dependencies": {
    "@emporium/domain": "*",
    "@neondatabase/serverless": "1.1.0",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10"
  }
}
