{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "ADMIN_DATABASE_URL",
        "AUTH_COOKIE_SECRET",
        "AUTH_SESSION_HOURS",
        "BLOB_READ_WRITE_TOKEN",
        "DATABASE_URL",
        "DATA_SOURCE",
        "PUBLIC_DATABASE_URL",
        "PUBLIC_REVALIDATE_SECONDS",
        "PUBLIC_SITE_URL",
        "REVALIDATION_SECRET",
        "SITE_URL",
        "VERCEL_GIT_COMMIT_MESSAGE",
        "VERCEL_GIT_COMMIT_SHA"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "out/**",
        "public/sitemap*.xml",
        "public/robots.txt"
      ],
      "env": [
        "ADMIN_DATABASE_URL",
        "AUTH_COOKIE_SECRET",
        "AUTH_SESSION_HOURS",
        "BLOB_READ_WRITE_TOKEN",
        "DATABASE_URL",
        "DATA_SOURCE",
        "PUBLIC_DATABASE_URL",
        "PUBLIC_REVALIDATE_SECONDS",
        "PUBLIC_SITE_URL",
        "REVALIDATION_SECRET",
        "SITE_URL",
        "VERCEL_GIT_COMMIT_MESSAGE",
        "VERCEL_GIT_COMMIT_SHA"
      ]
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
