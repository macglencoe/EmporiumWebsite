{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["DATA_SOURCE", "PUBLIC_DATABASE_URL", "PUBLIC_REVALIDATE_SECONDS", "REVALIDATION_SECRET", "PUBLIC_SITE_URL", "SITE_URL"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "out/**",
        "public/sitemap*.xml",
        "public/robots.txt"
      ],
      "env": ["DATA_SOURCE", "PUBLIC_DATABASE_URL", "PUBLIC_REVALIDATE_SECONDS", "REVALIDATION_SECRET", "PUBLIC_SITE_URL", "SITE_URL"]
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
